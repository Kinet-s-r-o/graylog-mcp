# Safe local/test configuration. Replace values for a real Graylog deployment.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=DEBUG

# Web UI Basic Auth
UI_USERNAME=test-admin
UI_PASSWORD=test-ui-password

# Graylog server URL and API token are entered in the Web UI.
GRAYLOG_DEFAULT_LIMIT=10
GRAYLOG_MAX_LIMIT=100

# Leave empty to test the MCP tools without OpenAI orchestration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MAX_TOOL_ROUNDS=3
QUERY_CATALOG_PATH=/app/queries.yaml

# Optional HTTPS reverse proxy (start with: docker compose --profile https up -d)
# Use a real public DNS name for Let's Encrypt; ports 80 and 443 must be reachable.
CADDY_DOMAIN=logs.example.com
CADDY_EMAIL=admin@example.com
CADDY_HTTP_BIND=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_WEBUI_BIND=0.0.0.0
CADDY_WEBUI_HTTPS_PORT=443
CADDY_MCP_BIND=0.0.0.0
CADDY_MCP_HTTPS_PORT=8443
CADDY_CERTS_DIR=./caddy/certs
# Empty = Let's Encrypt/automatic HTTPS. For a custom certificate use:
# CADDY_TLS_DIRECTIVE=tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
CADDY_TLS_DIRECTIVE=

# SQLite audit log retention
AUDIT_DB_PATH=/data/audit.db
AUDIT_RETENTION_DAYS=7
AUDIT_MAX_ROWS=10000
AUDIT_MAX_PAYLOAD_CHARS=50000
