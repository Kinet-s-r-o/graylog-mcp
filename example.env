# Safe local/test configuration. Replace values for a real Graylog deployment.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
# Host interface for the published backend port. Keep loopback when using Caddy.
MCP_BIND=127.0.0.1
# WebUI uses a separate native application port.
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8001
WEBUI_BIND=127.0.0.1
LOG_LEVEL=DEBUG

# Web UI Basic Auth
UI_USERNAME=test-admin
UI_PASSWORD=test-ui-password
UI_SESSION_TTL_SECONDS=28800
UI_MAX_SESSIONS=1000
UI_LOGIN_MAX_ATTEMPTS=5
UI_LOGIN_WINDOW_SECONDS=900
UI_LOGIN_MAX_CLIENTS=10000
# Set true when WebUI is served exclusively through HTTPS.
UI_COOKIE_SECURE=false
# Only these immediate proxies may supply X-Forwarded-For for CIDR enforcement.
# For the bundled Caddy container, use the actual private Docker network range.
TRUSTED_PROXY_CIDRS=

# Optional master secret used to encrypt Graylog API tokens stored in SQLite (at least 32 random characters).
# Keep it stable and outside version control. Losing it makes encrypted tokens unreadable.
SECRET_ENCRYPTION_KEY=

# Graylog server URL and API token are entered in the Web UI.
GRAYLOG_DEFAULT_LIMIT=10
GRAYLOG_MAX_LIMIT=100

# Leave empty to test the MCP tools without OpenAI orchestration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MAX_TOOL_ROUNDS=3
QUERY_CATALOG_PATH=/app/queries.yaml

# Optional HTTP/HTTPS reverse proxy (start with: docker compose --profile https up -d)
# Use a real public DNS name for Let's Encrypt; ports 80 and 443 must be reachable.
CADDY_DOMAIN=logs.example.com
CADDY_EMAIL=admin@example.com
# Port 80 remains dedicated to ACME and HTTPS redirects.
CADDY_HTTP_BIND=0.0.0.0
CADDY_HTTP_PORT=80
# Optional plain-HTTP WebUI listener. The MCP path is blocked on this port.
CADDY_WEBUI_HTTP_BIND=127.0.0.1
CADDY_WEBUI_HTTP_PORT=8080
CADDY_WEBUI_BIND=0.0.0.0
CADDY_WEBUI_HTTPS_PORT=443
CADDY_MCP_BIND=0.0.0.0
CADDY_MCP_HTTPS_PORT=8443
CADDY_CERTS_DIR=./caddy/certs
# Empty = Let's Encrypt/automatic HTTPS. For a custom certificate use:
# CADDY_TLS_DIRECTIVE=tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
CADDY_TLS_DIRECTIVE=

# SQLite audit log retention
AUDIT_DB_PATH=/data/audit.db
AUDIT_RETENTION_DAYS=7
AUDIT_MAX_ROWS=10000
AUDIT_MAX_PAYLOAD_CHARS=50000
AUDIT_REDACT_FIELDS=authorization,api_key,api_token,password,secret,token
