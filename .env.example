# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=INFO

# Web UI Basic Auth
UI_USERNAME=admin
UI_PASSWORD=change-this-ui-password

# Graylog REST API defaults (server URL and token are managed in the Web UI)
GRAYLOG_DEFAULT_LIMIT=100
GRAYLOG_MAX_LIMIT=1000

# Optional: OpenAI natural-language orchestration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MAX_TOOL_ROUNDS=5

# Custom query catalog
QUERY_CATALOG_PATH=/app/queries.yaml

# SQLite audit log retention
AUDIT_DB_PATH=/data/audit.db
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_ROWS=100000
AUDIT_MAX_PAYLOAD_CHARS=100000
