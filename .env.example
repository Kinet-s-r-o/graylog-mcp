# MCP HTTP server
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_BIND=127.0.0.1
LOG_LEVEL=INFO

# Web UI Basic Auth
UI_USERNAME=admin
UI_PASSWORD=change-this-ui-password
UI_SESSION_TTL_SECONDS=28800
UI_MAX_SESSIONS=1000
UI_LOGIN_MAX_ATTEMPTS=5
UI_LOGIN_WINDOW_SECONDS=900
UI_LOGIN_MAX_CLIENTS=10000
UI_COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=

# Optional encryption at rest for Graylog API tokens. Use at least 32 random characters and keep it stable.
SECRET_ENCRYPTION_KEY=

# Graylog REST API defaults (server URL and token are managed in the Web UI)
GRAYLOG_DEFAULT_LIMIT=100
GRAYLOG_MAX_LIMIT=1000

# Optional: OpenAI natural-language orchestration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MAX_TOOL_ROUNDS=5

# Custom query catalog
QUERY_CATALOG_PATH=/app/queries.yaml

# Optional HTTPS reverse proxy (start with: docker compose --profile https up -d)
CADDY_DOMAIN=logs.example.com
CADDY_EMAIL=admin@example.com
# Externally published HTTP port and host interface (redirect/ACME listener).
CADDY_HTTP_BIND=0.0.0.0
CADDY_HTTP_PORT=80
# Externally published HTTPS WebUI port and host interface.
CADDY_WEBUI_BIND=0.0.0.0
CADDY_WEBUI_HTTPS_PORT=443
# Externally published HTTPS MCP port and host interface.
CADDY_MCP_BIND=0.0.0.0
CADDY_MCP_HTTPS_PORT=8443
CADDY_CERTS_DIR=./caddy/certs
# Empty = automatic HTTPS. For a custom certificate use:
# CADDY_TLS_DIRECTIVE=tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
CADDY_TLS_DIRECTIVE=

# SQLite audit log retention
AUDIT_DB_PATH=/data/audit.db
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_ROWS=100000
AUDIT_MAX_PAYLOAD_CHARS=100000
AUDIT_REDACT_FIELDS=authorization,api_key,api_token,password,secret,token
