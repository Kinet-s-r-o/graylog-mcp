{
    email {$CADDY_EMAIL}
}

(tls_defaults) {
    # Leave CADDY_TLS_DIRECTIVE empty for Let's Encrypt/automatic HTTPS.
    # For a custom certificate set it in .env to:
    # tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
    {$CADDY_TLS_DIRECTIVE}
}

# Optional plain-HTTP WebUI entry point on a dedicated port. Port 80 remains
# available for ACME challenges and automatic HTTPS redirects.
# The optional HTTP WebUI listener is local by default and accepts localhost
# as well as the configured domain. HTTPS below remains domain-specific.
http://:{$CADDY_WEBUI_HTTP_PORT} {
    handle {$MCP_PATH}* {
        respond "Not Found" 404
    }
    handle {
        reverse_proxy graylog-mcp:{$WEBUI_PORT}
    }
}

# Optional plain-HTTP MCP entry point. The application MCP port is never
# published on the host; this listener is the only HTTP route for MCP.
http://:{$CADDY_MCP_HTTP_PORT} {
    @mcp_http path {$MCP_PATH}* /api/v1* /docs* /openapi.json /redoc*
    handle @mcp_http {
        reverse_proxy graylog-mcp:{$MCP_PORT}
    }
    handle /health {
        reverse_proxy graylog-mcp:{$MCP_PORT}
    }
    handle {
        respond "Not Found" 404
    }
}

{$CADDY_DOMAIN}:{$CADDY_WEBUI_HTTPS_PORT} {
    import tls_defaults

    # The WebUI port must not expose the MCP endpoint.
    handle {$MCP_PATH}* {
        respond "Not Found" 404
    }
    handle {
        reverse_proxy graylog-mcp:{$WEBUI_PORT}
    }
}

{$CADDY_DOMAIN}:{$CADDY_MCP_HTTPS_PORT} {
    import tls_defaults

    # The MCP port exposes only MCP and its health endpoint.
    @mcp_https path {$MCP_PATH}* /api/v1* /docs* /openapi.json /redoc*
    handle @mcp_https {
        reverse_proxy graylog-mcp:{$MCP_PORT}
    }
    handle /health {
        reverse_proxy graylog-mcp:{$MCP_PORT}
    }
    handle {
        respond "Not Found" 404
    }

}
